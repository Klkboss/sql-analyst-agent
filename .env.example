# Copy to .env and edit. Every value here is optional.

# Which LLM backend to use: ollama (local, default) or groq (cloud)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b          # accuracy runs (~84% on GPU)
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M   # fast dev model, fits fully on GPU

# Context window in tokens. Chinook fits in 4096; raise for big BIRD schemas.
OLLAMA_NUM_CTX=4096
# Layers to put on the GPU. Empty = let Ollama decide; 0 = CPU only.
OLLAMA_NUM_GPU=
# How long the model stays loaded after a call, so retries don't reload it.
OLLAMA_KEEP_ALIVE=10m

# --- Self-correction switches (1 = on); see eval/results/summary.md for their effect ---
# Treat a single row of 0/NULL (e.g. COUNT = 0) as suspicious and retry
SUSPECT_ZERO_AGG=0
# Retry prompt forbids changing/loosening the user's filters
STRICT_RETRY=0

# --- Groq (only needed when LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
