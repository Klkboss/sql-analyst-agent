# Copy to .env and edit. Every value here is optional.

# Which LLM backend to use: ollama (local, default) or groq (cloud)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M   # default: best on BIRD, fits fully on a 6 GB GPU
# OLLAMA_MODEL=qwen2.5-coder:7b              # alt: ~5 points lower on BIRD, ~1.7x slower here

# Context window in tokens. 8192 fits Olist + notes + follow-ups; the 4B model still runs
# 100% on a 6 GB GPU. (The BIRD benchmark pins 4096 itself, whatever this says.)
OLLAMA_NUM_CTX=8192
# Layers to put on the GPU. Empty = let Ollama decide; 0 = CPU only.
OLLAMA_NUM_GPU=
# How long the model stays loaded after a call, so retries don't reload it.
OLLAMA_KEEP_ALIVE=10m

# --- Self-correction switches (1 = on); see eval/results/summary.md for their effect ---
# Treat a single row of 0/NULL (e.g. COUNT = 0) as suspicious and retry
SUSPECT_ZERO_AGG=1
# Retry prompt forbids changing/loosening the user's filters (tested on BIRD: no gain)
STRICT_RETRY=0
# Retry when the SQL joins through a scalar subquery or hides the value it ranks by
CHECK_SQL_SHAPE=1
# Retry when COUNT/SUM runs over rows that a one-to-many join repeated (off: net loss on BIRD)
CHECK_FANOUT=0

# --- Groq (only needed when LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
